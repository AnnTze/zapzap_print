MONITOR_BOT_TOKEN=YOUR_MONITOR_BOT_TOKEN
PRINT_BOT_TOKEN=YOUR_PRINT_BOT_TOKEN
MONITOR_PASSWORD=changeme
RIBBON_CAPACITY=700
LOG_FILE=print_log.jsonl
LOG_ARCHIVE_DIR=logs
GALLERY_BOT_TOKEN=YOUR_GALLERY_BOT_TOKEN
GALLERY_CHANNEL_ID=YOUR_CHANNEL_ID
GALLERY_LOG_FILE=gallery_log.jsonl
MAX_PRINTS_PER_MESSAGE=5

# --- Printer (cross-platform) ---
# CUPS name (macOS) or Windows printer name. Find it with:
#   macOS:   lpstat -p
#   Windows: Get-Printer | Select-Object Name   (or run scripts/find_paper_form.py)
PRINTER_NAME=MITSUBISHI_CPD90D

# macOS/CUPS media name passed to lpr (-o media=...). Default suits the CP-D90DW.
CUPS_MEDIA=ME_10x15

# Windows only: borderless 4x6 / 10x15 paper form. Preferably the numeric paper ID
# (DEVMODE.PaperSize) resolved once via scripts/find_paper_form.py; a form *name*
# also works but is resolved live against the driver, which is less reliable.
# Leave blank on macOS.
WINDOWS_PAPER_FORM_NAME=
# Maximum total prints allowed per message (across all photos and copies).
# A single message with 2 photos captioned "2,3" = 5 total prints.
# Change this value to raise or lower the limit without touching code.

# --- Watermark (printed photos only, not the gallery channel copy) ---
# Path to a logo image (PNG with transparency recommended). If missing, printing
# proceeds without a watermark and a warning is logged once.
WATERMARK_PATH=watermark.png
# 0.0 (invisible) - 1.0 (fully opaque), applied on top of the logo's own alpha.
WATERMARK_OPACITY=0.35
# Logo size as a fraction of the shorter side of the print canvas.
WATERMARK_SCALE=0.6
# Gap between the logo's bottom edge and the paper's bottom edge, as a fraction
# of canvas height.
WATERMARK_MARGIN=0.05
