# Hub configuration. Copy to hub.env on the machine running the dashboard.

# Where the sqlite database lives.
HUB_DB=hub.db

# Interface to bind. 127.0.0.1 keeps the dashboard on this machine only.
# Set to your Tailscale address (100.x.y.z) to reach it from a phone without
# exposing the dashboard on venue wifi.
HUB_BIND=127.0.0.1
HUB_PORT=8080
